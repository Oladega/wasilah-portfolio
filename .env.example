# Canonical production origin, without a path. Defaults to the current Vercel site.
SITE_URL=https://wasilah-portfolio.vercel.app
# Only use real tokens issued by the search engine dashboards.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Set true for non-production builds outside Vercel. VERCEL_ENV=preview also noindexes.
SITE_NOINDEX=false
