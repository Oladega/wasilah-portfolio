{
  "name": "wasilah-portfolio",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:reference": "node scripts/audit-reference.mjs",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:content": "node scripts/content-check.mjs",
    "test:overlays": "node scripts/overlay-check.mjs",
    "test:navigation": "node scripts/navigation-check.mjs",
    "test:pdf-media": "node scripts/pdf-media-check.mjs",
    "test:about-content": "node scripts/about-content-check.mjs",
    "test:design-update": "node scripts/design-update-check.mjs",
    "test:welcome": "node scripts/welcome-check.mjs",
    "test:windows": "node scripts/window-state-check.mjs && node scripts/window-cleanup-check.mjs",
    "test:window-controls": "node scripts/window-cleanup-check.mjs",
    "test:window-animations": "node scripts/window-animation-check.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/optimize-portfolio-images.mjs && node scripts/generate-og-images.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/optimize-portfolio-images.mjs && node scripts/generate-og-images.mjs",
    "test:resume-zoom": "node scripts/resume-zoom-check.mjs",
    "test:final-review": "node scripts/final-window-review.mjs",
    "profile:windows": "node scripts/profile-window-experience.mjs",
    "profile:memory": "node scripts/profile-window-memory.mjs",
    "test:window-flicker": "node scripts/window-flicker-check.mjs",
    "test:window-handoff-pixels": "node scripts/window-handoff-pixels.mjs",
    "test:seo": "node scripts/seo-check.mjs",
    "audit:lighthouse": "node scripts/lighthouse-seo.mjs",
    "test:external": "npm run build && node scripts/external-http-check.mjs --local",
    "test:external:production": "node scripts/external-http-check.mjs",
    "test:project-order": "node scripts/project-order-check.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "node scripts/build-cloudflare.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json --port 3010",
    "test:cloudflare": "node scripts/cloudflare-check.mjs",
    "build:cloudflare:production": "node scripts/build-cloudflare.mjs --production"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vinext/cloudflare": "^1.2.1",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "lighthouse": "^12.8.2",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-css-modules": "^1.16.0",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module"
}
