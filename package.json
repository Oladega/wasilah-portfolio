    "test:pdf-media": "node scripts/pdf-media-check.mjs",
    "test:about-content": "node scripts/about-content-check.mjs",
    "test:design-update": "node scripts/design-update-check.mjs",
    "test:welcome": "node scripts/welcome-check.mjs",
