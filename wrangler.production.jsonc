{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wasilah-portfolio",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "wasilah.online", "custom_domain": true },
    { "pattern": "www.wasilah.online", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/_vinext/static-cache/*"]
  }
}
